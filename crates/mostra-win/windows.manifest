<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Mostra's Windows programs run as whoever starts them (D153). Without a requested execution
     level, UAC's installer detection takes a program whose name says "setup" (the bundle's
     mostra-setup.exe) for an installer and refuses it to an ordinary user. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
