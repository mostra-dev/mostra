{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "ignoreDependencies": ["@changesets/changelog-github", "@mostra/tools", "turbo"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/fixtures/artifacts/**"]
    },
    "tools": {
      "entry": [
        "bin/*.ts",
        "*/cli.ts",
        "check/fix.ts",
        "docs/*.ts",
        "test/**/*.test.ts",
        "github/*.ts"
      ],
      "project": ["**/*.ts", "!**/fixtures/**"],
      "ignore": ["**/fixtures/**"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "@mostra/tools-ts6"]
    },
    "tools/ts6": {
      "entry": ["*.mjs"],
      "project": ["*.mjs"]
    },
    "tests/*": {
      "entry": ["*.config.ts", "**/*.spec.ts", "global-setup.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@mostra/runtime", "@mostra/server", "@mostra/shell"],
      "ignore": ["fixtures/**"]
    },
    "packages/runtime": {
      "entry": ["src/index.ts", "src/bin.ts", "src/builder/child/main.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignore": ["test/fixtures/artifacts/**"],
      "ignoreDependencies": [
        "tailwindcss",
        "pnpm",
        "@mostra/shell",
        "@mostra/verify",
        "@mostra/warm",
        "@mostra/worker"
      ],
      "ignoreBinaries": ["ss", "lsof", "ps", "plutil"]
    },
    "packages/warm": {
      "entry": [],
      "project": [],
      "ignoreDependencies": [".+"]
    },
    "packages/shell": {
      "entry": ["src/main.tsx", "index.html", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"]
    }
  },
  "ignore": ["docs/design/evaluations/**"],
  "ignoreExportsUsedInFile": true
}
