{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "pnpm-workspace.yaml", ".node-version"],
  "globalPassThroughEnv": ["GITHUB_BASE_REF", "GITHUB_ACTIONS", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!test/**", "!**/*.md"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".tsbuild/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "env": ["MOSTRA_TEST_GROUP"]
    },
    "size": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "api": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.changeset/*.md"],
      "outputs": [],
      "env": ["MOSTRA_BASE"]
    },
    "schemas": {
      "outputs": [],
      "env": ["MOSTRA_BASE"]
    },
    "test:hygiene": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "e2e": {
      "dependsOn": ["^build"],
      "env": ["MOSTRA_E2E_BROWSER"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    }
  }
}
