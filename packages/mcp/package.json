{
  "name": "@mostra/mcp",
  "version": "0.14.0",
  "description": "Mostra's MCP server: the tools, resources and HTTP handler `mostra mcp` serves to any MCP client, independent of the transport.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api": "mostra-tools api",
    "schemas": "mostra-tools schemas check",
    "gen:schemas": "mostra-tools schemas write"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@mostra/protocol": "workspace:*",
    "diff": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mostra/tools": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@modelcontextprotocol/client": "catalog:"
  },
  "keywords": [
    "mostra",
    "mcp",
    "model-context-protocol",
    "agent",
    "artifact"
  ]
}
