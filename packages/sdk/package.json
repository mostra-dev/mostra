{
  "name": "@mostra/sdk",
  "version": "0.7.0",
  "description": "Embed Mostra in a JavaScript host: createMostra({ home, ports }) spawns a verified runtime bundle, serves your ports and speaks the host protocol.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "api": "mostra-tools api",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@mostra/protocol": "workspace:*",
    "tar": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@mostra/runtime": "workspace:*",
    "@mostra/tools": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "mostra",
    "agent",
    "artifact",
    "sdk",
    "host"
  ],
  "bin": {
    "mostra-setup": "./dist/setup-main.js"
  }
}
