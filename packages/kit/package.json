  "mostra-kit": {
    "assets": [
      {
        "package": "@excalidraw/excalidraw",
        "from": "dist/prod/fonts",
        "to": "excalidraw/fonts",
        "skip": [
          "Xiaolai"
        ]
      }
    ]
  },
  "size-limit": [
    {
      "name": "@mostra/kit/questionnaire (React, the client runtime and the icons excluded)",
      "path": "dist/questionnaire.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "@mostra/react",
        "lucide-react",
        "cn",
        "@mostra/kit/layout"
      ],
      "limit": "5 kB"
    },
    {
      "name": "@mostra/kit/layout (React excluded)",
      "path": "dist/layout.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "@mostra/react",
        "lucide-react",
        "cn"
      ],
      "limit": "1.5 kB"
    },
    {
      "name": "@mostra/kit/review (React and the client runtime excluded)",
      "path": "dist/review.js",
      "import": "*",
      "ignore": [
        "@mostra/react",
        "cn",
        "lucide-react",
        "react",
        "react-dom"
      ],
      "limit": "2.5 kB"
    },
    {
      "name": "@mostra/kit/tokens (React, the client runtime, the kit's other modules excluded)",
      "path": "dist/tokens.js",
      "import": "*",
      "ignore": [
        "react",
        "react-dom",
        "@mostra/react",
        "cn",
        "lucide-react",
