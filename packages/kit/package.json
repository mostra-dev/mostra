{
  "name": "@mostra/kit",
  "version": "0.20.0",
  "description": "Mostra's kit: shadcn components for the Base UI and Radix bases, shaped by the themes' tokens, the questionnaire and form parts that save as fields, and token-aware charts, tables, diagrams, code, math, maps, 3D and team parts.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/kit"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./questionnaire": {
      "@mostra/source": "./src/questionnaire.tsx",
      "types": "./dist/questionnaire.d.ts",
      "default": "./dist/questionnaire.js"
    },
    "./layout": {
      "@mostra/source": "./src/layout.tsx",
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    },
    "./review": {
      "@mostra/source": "./src/review.tsx",
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./tokens": {
      "@mostra/source": "./src/tokens.tsx",
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./live-chart": {
      "@mostra/source": "./src/live-chart.tsx",
      "types": "./dist/live-chart.d.ts",
      "default": "./dist/live-chart.js"
    },
    "./charts": {
      "@mostra/source": "./src/charts.tsx",
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./echarts": {
      "@mostra/source": "./src/echarts.tsx",
      "types": "./dist/echarts.d.ts",
      "default": "./dist/echarts.js"
    },
    "./data-table": {
      "@mostra/source": "./src/data-table.tsx",
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./mermaid": {
      "@mostra/source": "./src/mermaid.tsx",
      "types": "./dist/mermaid.d.ts",
      "default": "./dist/mermaid.js"
    },
    "./flow": {
      "@mostra/source": "./src/flow.tsx",
      "types": "./dist/flow.d.ts",
      "default": "./dist/flow.js"
    },
    "./code": {
      "@mostra/source": "./src/code.tsx",
      "types": "./dist/code.d.ts",
      "default": "./dist/code.js"
    },
    "./math": {
      "@mostra/source": "./src/math.tsx",
      "types": "./dist/math.d.ts",
      "default": "./dist/math.js"
    },
    "./map": {
      "@mostra/source": "./src/map.tsx",
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./scene": {
      "@mostra/source": "./src/scene.tsx",
      "types": "./dist/scene.d.ts",
      "default": "./dist/scene.js"
    },
    "./whiteboard": {
      "@mostra/source": "./src/whiteboard.tsx",
      "types": "./dist/whiteboard.d.ts",
      "default": "./dist/whiteboard.js"
    },
    "./team": {
      "@mostra/source": "./src/team.tsx",
      "types": "./dist/team.d.ts",
      "default": "./dist/team.js"
    },
    "./css/*": "./css/*",
    "./registry/*": "./registry/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "css",
    "registry"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api": "mostra-tools api",
    "generate": "node --conditions @mostra/source scripts/generate.ts",
    "size": "size-limit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-css": "catalog:",
