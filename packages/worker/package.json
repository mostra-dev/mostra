{
  "name": "@mostra/worker",
  "version": "0.5.0",
  "description": "The process that runs one artifact version's server code: server functions, action runs and live producers.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/worker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/worker"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api": "mostra-tools api"
  },
  "dependencies": {
    "@mostra/protocol": "workspace:*",
    "@mostra/server": "workspace:*"
  },
  "devDependencies": {
    "@mostra/tools": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "mostra-worker": "./dist/main.js"
  }
}
