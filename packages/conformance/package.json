{
  "name": "@mostra/conformance",
  "version": "0.2.0",
  "description": "Prove a host's Mostra integration: conformance scenarios run against your host through a small harness protocol, with expected-failure baselines and reference hosts.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/conformance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/conformance"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "baselines",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "api": "mostra-tools api",
    "test:integration": "vitest run --project integration",
    "conformance": "node --conditions=@mostra/source src/cli.ts"
  },
  "dependencies": {
    "@mostra/protocol": "workspace:*",
    "@mostra/sdk": "workspace:*",
    "playwright-core": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mostra/tools": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@mostra/runtime": "workspace:*"
  },
  "keywords": [
    "mostra",
    "agent",
    "artifact",
    "conformance",
    "host"
  ],
  "bin": {
    "mostra-conformance": "./dist/cli.js",
    "mostra-conformance-reference-host": "./dist/reference-host.js"
  }
}
