{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mostra protocol types: IDs, revisions and diagnostics",
  "x-mostra-revisions": {
    "host-protocol": "2026-10-10"
  },
  "definitions": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "CommentId": {
      "type": "string",
      "pattern": "^cmt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/DiagnosticCode"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverity"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "fix": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticFix"
            }
          ]
        },
        "location": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticLocation"
            }
          ]
        },
        "phase": {
          "$ref": "#/definitions/DiagnosticPhase"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "phase",
        "docs"
      ]
    },
    "DiagnosticCode": {
      "type": "string",
      "pattern": "^MOSTRA_[A-Z0-9]+_[A-Z0-9_]+$"
    },
    "DiagnosticFix": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "replace",
            "insert",
            "delete",
            "command"
          ]
        },
        "file": {
          "type": "string"
        },
        "range": {
          "readOnly": true,
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ],
          "additionalItems": false,
          "minItems": 4,
          "maxItems": 4
        },
        "text": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "DiagnosticLocation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "file",
            "line",
            "column"
          ]
        },
        {
          "type": "object",
          "properties": {
            "viewport": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "viewport"
          ]
        }
      ]
    },
    "DiagnosticPhase": {
      "type": "string",
      "enum": [
        "manifest",
        "compile",
        "lint",
        "runtime",
        "console",
        "network",
        "a11y",
        "visual",
        "smoke",
        "regression",
        "contract",
        "publish",
        "host",
        "hygiene",
        "platform"
      ]
    },
    "DiagnosticSeverity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "hint"
      ]
    },
    "MutationId": {
      "type": "string",
      "pattern": "^mut_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "Revision": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "SubmissionId": {
      "type": "string",
      "pattern": "^sub_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ThreadId": {
      "type": "string",
      "pattern": "^thr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TokenId": {
      "type": "string",
      "pattern": "^tok_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "VersionId": {
      "type": "string",
      "pattern": "^ver_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ViewId": {
      "type": "string",
      "pattern": "^vw_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ViewerId": {
      "type": "string",
      "pattern": "^vwr_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
