{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mostra protocol types: IDs, revisions and diagnostics",
  "x-mostra-revisions": {
    "host-protocol": "2026-10-10"
  },
  "definitions": {
    "AddedPackage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "warm": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "warm"
      ],
      "description": "A package deps/add settled: its name, exact version and whether it is warm."
    },
    "ArtifactCreateParams": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "pattern": "^\\/"
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dir"
      ]
    },
    "ArtifactCreateResult": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/definitions/ArtifactId"
        },
        "dir": {
          "type": "string"
        },
        "files": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifactId",
        "dir",
        "files"
      ]
    },
    "ArtifactDetail": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ArtifactId"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "links": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactLink"
          }
        },
        "mode": {
          "type": "string",
          "const": "spa"
        },
        "policy": {
          "allOf": [
            {
              "$ref": "#/definitions/SubmissionPolicy"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "latestVersion": {
          "allOf": [
            {
              "$ref": "#/definitions/VersionSummary"
            }
          ]
        },
        "manifest": {
          "$ref": "#/definitions/ArtifactManifest"
        },
        "versions": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/VersionSummary"
          }
        }
      },
      "required": [
        "id",
        "title",
        "links",
        "mode",
        "createdAt",
        "manifest",
        "versions"
      ],
      "description": "One artifact in full: its summary, the latest manifest and every version."
    },
    "ArtifactGetParams": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/definitions/ArtifactRef"
        }
      },
      "required": [
        "artifact"
      ]
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Artifact ID: \"art_\" followed by a 26-character ULID."
    },
    "ArtifactLink": {
      "type": "object",
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rel",
        "artifact"
      ],
      "description": "A related artifact: how this one relates (rel) and the other artifact's ID."
    },
    "ArtifactListParams": {
      "type": "object",
      "properties": {
        "filter": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ArtifactListResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactSummary"
          }
        }
      },
      "required": [
        "artifacts"
      ]
    },
    "ArtifactManifest": {
      "type": "object",
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/ArtifactId"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "links": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactLink"
          }
        },
        "mode": {
          "type": "string",
          "const": "spa"
        },
        "submission": {
          "allOf": [
            {
              "$ref": "#/definitions/SubmissionPolicy"
            }
          ]
        },
        "kit": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string",
              "enum": [
                "base",
                "radix"
              ]
            },
            "theme": {
              "type": "string"
            }
          }
        },
        "terminals": {
          "readOnly": true,
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "readOnly": true,
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              },
              "env": {
                "readOnly": true,
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cols": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "input": {
                "type": "boolean"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "demos": {
          "readOnly": true,
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "command": {
                    "readOnly": true,
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "ready": {
                    "type": "string"
                  },
                  "bridge": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "command"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "attach": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "bridge": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "attach"
                ]
              }
            ]
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "heapMb": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "watchdogMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "idleMinutes": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "verify": {
          "type": "object",
          "properties": {
            "viewports": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frames": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraChecks": {
              "readOnly": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "smoke": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "title"
      ],
      "description": "The artifact manifest (INTERFACES §2.2): literal metadata from the entry's defineArtifact call or MDX frontmatter."
    },
    "ArtifactPublishParams": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/definitions/SourceRef"
        },
        "force": {
          "type": "boolean"
        },
        "policy": {
          "allOf": [
            {
              "$ref": "#/definitions/SubmissionPolicy"
            }
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ]
    },
    "ArtifactRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "required": [
            "artifactId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\/"
            }
          },
          "required": [
            "path"
          ]
        }
      ],
      "description": "Names an artifact by its ID or by an absolute source path bound to it."
    },
    "ArtifactSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ArtifactId"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "links": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactLink"
          }
        },
        "mode": {
          "type": "string",
          "const": "spa"
        },
        "policy": {
          "allOf": [
            {
              "$ref": "#/definitions/SubmissionPolicy"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "latestVersion": {
          "allOf": [
            {
              "$ref": "#/definitions/VersionSummary"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "links",
        "mode",
        "createdAt"
      ],
      "description": "One artifact: metadata from its latest version, its source and latest version."
    },
    "CapabilityLink": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "tokenId": {
          "$ref": "#/definitions/TokenId"
        },
        "scopes": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/CapabilityScope"
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "url",
        "tokenId",
        "scopes"
      ],
      "description": "A capability URL with its token ID, scopes and expiry."
    },
    "CapabilityScope": {
      "type": "string",
      "pattern": "^(view|draft|submit|review|signal|action:(\\*|[^\\s#*]+(#[^\\s#*]+)?))$",
      "description": "A capability token's scope: view, draft, submit, review, signal, action:*, action:<export> or action:<module path>#<export>."
    },
    "ChildProcessStatus": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string"
        },
        "ownerRef": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "pid",
        "kind",
        "ownerRef",
        "startedAt"
      ],
      "description": "One child process the instance supervises."
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "notifications": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "What the client can handle: the notification methods it accepts."
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "The client that opens a connection."
    },
    "CommentId": {
      "type": "string",
      "pattern": "^cmt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Comment ID: \"cmt_\" followed by a 26-character ULID."
    },
    "Cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Event cursor: the decimal string of a home-wide event position."
    },
    "DependencyPolicy": {
      "type": "string",
      "enum": [
        "auto",
        "explicit"
      ],
      "description": "How packages enter an artifact's lockfile: auto installs what artifacts import; explicit only what deps/add adds (D43)."
    },
    "DepsAddParams": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/definitions/SourceRef"
        },
        "packages": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "packages"
      ]
    },
    "DepsAddResult": {
      "type": "object",
      "properties": {
        "packages": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/AddedPackage"
          }
        },
        "lockDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "packages",
        "lockDigest"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/DiagnosticCode"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverity"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "fix": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticFix"
            }
          ]
        },
        "location": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticLocation"
            }
          ]
        },
        "phase": {
          "$ref": "#/definitions/DiagnosticPhase"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "phase",
        "docs"
      ],
      "description": "One diagnostic: a stable code, severity, message, hint, fix and docs link."
    },
    "DiagnosticCode": {
      "type": "string",
      "pattern": "^MOSTRA_[A-Z0-9]+_[A-Z0-9_]+$",
      "description": "Stable diagnostic code: MOSTRA_<AREA>_<NAME>."
    },
    "DiagnosticFix": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "replace",
            "insert",
            "delete",
            "command"
          ]
        },
        "file": {
          "type": "string"
        },
        "range": {
          "readOnly": true,
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ],
          "additionalItems": false,
          "minItems": 4,
          "maxItems": 4
        },
        "text": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "description": "A machine-applicable fix; range is [startLine, startColumn, endLine, endColumn], 1-based, end exclusive."
    },
    "DiagnosticLocation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "file",
            "line",
            "column"
          ]
        },
        {
          "type": "object",
          "properties": {
            "viewport": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "viewport"
          ]
        }
      ],
      "description": "A 1-based source position, or a place in a rendered viewport."
    },
    "DiagnosticPhase": {
      "type": "string",
      "enum": [
        "manifest",
        "compile",
        "lint",
        "runtime",
        "console",
        "network",
        "a11y",
        "visual",
        "smoke",
        "regression",
        "contract",
        "publish",
        "host",
        "hygiene",
        "platform"
      ],
      "description": "The stage of work that produced the diagnostic."
    },
    "DiagnosticSeverity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "hint"
      ],
      "description": "How bad it is: error only for definite failures."
    },
    "Duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,8}[smhd]$",
      "description": "A duration: a positive whole number and s, m, h or d, such as 30m, 24h or 7d."
    },
    "GatewayStatus": {
      "type": "object",
      "properties": {
        "bind": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "artifacts": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifactId": {
                "type": "string"
              },
              "origin": {
                "type": "string"
              }
            },
            "required": [
              "artifactId",
              "origin"
            ]
          }
        }
      },
      "required": [
        "bind",
        "shell",
        "artifacts"
      ],
      "description": "Where the gateway listens."
    },
    "HomeConfig": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "allOf": [
            {
              "$ref": "#/definitions/DependencyPolicy"
            }
          ]
        }
      },
      "description": "Home settings from a spawning host; path is a check against the instance's home (D84), dependencies the dependency policy (D43)."
    },
    "InstanceCapabilities": {
      "type": "object",
      "properties": {
        "methods": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notifications": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PortName"
          }
        }
      },
      "required": [
        "methods",
        "notifications",
        "ports"
      ],
      "description": "What the instance offers: methods, notifications and supported ports."
    },
    "InstanceInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "host",
            "daemon"
          ]
        }
      },
      "required": [
        "version",
        "home",
        "platform",
        "pid",
        "mode"
      ],
      "description": "The instance a client is connected to."
    },
    "InstanceStatusParams": {
      "type": "object",
      "properties": {}
    },
    "InstanceStatusResult": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/definitions/InstanceInfo"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "socket": {
          "type": "string"
        },
        "connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processes": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChildProcessStatus"
          }
        },
        "gateway": {
          "allOf": [
            {
              "$ref": "#/definitions/GatewayStatus"
            }
          ]
        }
      },
      "required": [
        "instance",
        "startedAt",
        "socket",
        "connections",
        "processes"
      ]
    },
    "JsonRpcErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "code",
        "message"
      ],
      "description": "The error of a failed JSON-RPC 2.0 response; Mostra puts the diagnostic in data."
    },
    "JsonRpcFailure": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "error": {
          "$ref": "#/definitions/JsonRpcErrorObject"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "description": "A failed JSON-RPC 2.0 response; id is null when the request's id was unreadable."
    },
    "JsonRpcNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "readOnly": true,
              "type": "array",
              "items": {}
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "description": "A JSON-RPC 2.0 notification: a request without an id, never answered."
    },
    "JsonRpcRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "readOnly": true,
              "type": "array",
              "items": {}
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "description": "A JSON-RPC 2.0 request: answered by a response with the same id."
    },
    "JsonRpcSuccess": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "result": {}
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "description": "A successful JSON-RPC 2.0 response."
    },
    "MostraInitializeParams": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/definitions/ClientInfo"
        },
        "revisions": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/definitions/ClientCapabilities"
        },
        "ports": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PortName"
          }
        },
        "home": {
          "allOf": [
            {
              "$ref": "#/definitions/HomeConfig"
            }
          ]
        }
      },
      "required": [
        "client",
        "revisions",
        "capabilities",
        "ports"
      ]
    },
    "MostraInitializeResult": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/definitions/Revision"
        },
        "instance": {
          "$ref": "#/definitions/InstanceInfo"
        },
        "capabilities": {
          "$ref": "#/definitions/InstanceCapabilities"
        },
        "warnings": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        }
      },
      "required": [
        "revision",
        "instance",
        "capabilities",
        "warnings"
      ]
    },
    "MostraShutdownParams": {
      "type": "object",
      "properties": {}
    },
    "MostraShutdownResult": {
      "type": "object",
      "properties": {}
    },
    "MutationId": {
      "type": "string",
      "pattern": "^mut_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Mutation ID: \"mut_\" followed by a 26-character ULID."
    },
    "PortName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "A host port name: identity, submissions, drafts, reviews, addressing, trustedControls, capture, secrets, pty, or ai (reserved). Open for later ports."
    },
    "PublishReceipt": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/definitions/ArtifactId"
        },
        "versionId": {
          "$ref": "#/definitions/VersionId"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string"
        },
        "tokenId": {
          "allOf": [
            {
              "$ref": "#/definitions/TokenId"
            }
          ]
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        },
        "reused": {
          "type": "boolean"
        },
        "forcedDiagnostics": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "version",
        "cursor",
        "reused"
      ],
      "description": "The receipt of artifact/publish: artifact, version, number, capability URL when served, event cursor, reuse."
    },
    "Revision": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Protocol revision: a calendar date in YYYY-MM-DD form."
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Action run ID: \"run_\" followed by a 26-character ULID."
    },
    "SourceRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\/"
            }
          },
          "required": [
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "artifactId": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "required": [
            "artifactId"
          ]
        }
      ],
      "description": "Where to build an artifact from: an absolute source path, or an artifact ID (its last published source path)."
    },
    "SubmissionId": {
      "type": "string",
      "pattern": "^sub_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Submission ID: \"sub_\" followed by a 26-character ULID."
    },
    "SubmissionPolicy": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "once"
            },
            "scope": {
              "type": "string",
              "enum": [
                "per-artifact",
                "per-viewer"
              ]
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "epochs"
            }
          },
          "required": [
            "policy"
          ]
        },
        {
          "type": "object",
          "properties": {
            "policy": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "policy"
          ]
        }
      ],
      "description": "A submission policy: once (per-artifact or per-viewer), epochs, or none."
    },
    "ThreadId": {
      "type": "string",
      "pattern": "^thr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Thread ID: \"thr_\" followed by a 26-character ULID."
    },
    "TokenId": {
      "type": "string",
      "pattern": "^tok_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Capability token ID: \"tok_\" followed by a 26-character ULID."
    },
    "VersionId": {
      "type": "string",
      "pattern": "^ver_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Version ID: \"ver_\" followed by 26 characters of Crockford base32."
    },
    "VersionSummary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/VersionId"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "envDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outputDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forcedDiagnostics": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "number",
        "publishedAt",
        "sourceDigest",
        "envDigest",
        "outputDigest"
      ],
      "description": "One published version."
    },
    "ViewId": {
      "type": "string",
      "pattern": "^vw_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "View ID: \"vw_\" followed by a 26-character ULID."
    },
    "ViewRevokeParams": {
      "type": "object",
      "properties": {
        "tokenId": {
          "$ref": "#/definitions/TokenId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tokenId"
      ]
    },
    "ViewRevokeResult": {
      "type": "object",
      "properties": {}
    },
    "ViewRotateParams": {
      "type": "object",
      "properties": {
        "tokenId": {
          "$ref": "#/definitions/TokenId"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tokenId"
      ]
    },
    "ViewUrlParams": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/definitions/ArtifactRef"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "$ref": "#/definitions/VersionId"
            }
          ]
        },
        "scopes": {
          "readOnly": true,
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/CapabilityScope"
          }
        },
        "ttl": {
          "allOf": [
            {
              "$ref": "#/definitions/Duration"
            }
          ]
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact"
      ]
    },
    "ViewerId": {
      "type": "string",
      "pattern": "^vwr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Viewer ID: \"vwr_\" followed by a 26-character ULID."
    }
  }
}
