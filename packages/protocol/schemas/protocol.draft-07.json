{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mostra protocol types: IDs, revisions and diagnostics",
  "x-mostra-revisions": {
    "host-protocol": "2026-10-10"
  },
  "definitions": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Artifact ID: \"art_\" followed by a 26-character ULID."
    },
    "ChildProcessStatus": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string"
        },
        "ownerRef": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "pid",
        "kind",
        "ownerRef",
        "startedAt"
      ],
      "description": "One child process the instance supervises."
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "notifications": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "What the client can handle: the notification methods it accepts."
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "description": "The client that opens a connection."
    },
    "CommentId": {
      "type": "string",
      "pattern": "^cmt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Comment ID: \"cmt_\" followed by a 26-character ULID."
    },
    "Cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "description": "Event cursor: the decimal string of a home-wide event position."
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/DiagnosticCode"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverity"
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "fix": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticFix"
            }
          ]
        },
        "location": {
          "allOf": [
            {
              "$ref": "#/definitions/DiagnosticLocation"
            }
          ]
        },
        "phase": {
          "$ref": "#/definitions/DiagnosticPhase"
        },
        "docs": {
          "type": "string",
          "format": "uri"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "phase",
        "docs"
      ],
      "description": "One diagnostic: a stable code, severity, message, hint, fix and docs link."
    },
    "DiagnosticCode": {
      "type": "string",
      "pattern": "^MOSTRA_[A-Z0-9]+_[A-Z0-9_]+$",
      "description": "Stable diagnostic code: MOSTRA_<AREA>_<NAME>."
    },
    "DiagnosticFix": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "replace",
            "insert",
            "delete",
            "command"
          ]
        },
        "file": {
          "type": "string"
        },
        "range": {
          "readOnly": true,
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ],
          "additionalItems": false,
          "minItems": 4,
          "maxItems": 4
        },
        "text": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "description": "A machine-applicable fix; range is [startLine, startColumn, endLine, endColumn], 1-based, end exclusive."
    },
    "DiagnosticLocation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "file",
            "line",
            "column"
          ]
        },
        {
          "type": "object",
          "properties": {
            "viewport": {
              "type": "string"
            },
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "viewport"
          ]
        }
      ],
      "description": "A 1-based source position, or a place in a rendered viewport."
    },
    "DiagnosticPhase": {
      "type": "string",
      "enum": [
        "manifest",
        "compile",
        "lint",
        "runtime",
        "console",
        "network",
        "a11y",
        "visual",
        "smoke",
        "regression",
        "contract",
        "publish",
        "host",
        "hygiene",
        "platform"
      ],
      "description": "The stage of work that produced the diagnostic."
    },
    "DiagnosticSeverity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "hint"
      ],
      "description": "How bad it is: error only for definite failures."
    },
    "HomeConfig": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "Home settings from a spawning host; path is a check against the instance's home (D84)."
    },
    "InstanceCapabilities": {
      "type": "object",
      "properties": {
        "methods": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notifications": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PortName"
          }
        }
      },
      "required": [
        "methods",
        "notifications",
        "ports"
      ],
      "description": "What the instance offers: methods, notifications and supported ports."
    },
    "InstanceInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "host",
            "daemon"
          ]
        }
      },
      "required": [
        "version",
        "home",
        "platform",
        "pid",
        "mode"
      ],
      "description": "The instance a client is connected to."
    },
    "InstanceStatusParams": {
      "type": "object",
      "properties": {}
    },
    "InstanceStatusResult": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/definitions/InstanceInfo"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "socket": {
          "type": "string"
        },
        "connections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processes": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChildProcessStatus"
          }
        }
      },
      "required": [
        "instance",
        "startedAt",
        "socket",
        "connections",
        "processes"
      ]
    },
    "JsonRpcErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "code",
        "message"
      ],
      "description": "The error of a failed JSON-RPC 2.0 response; Mostra puts the diagnostic in data."
    },
    "JsonRpcFailure": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "error": {
          "$ref": "#/definitions/JsonRpcErrorObject"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "description": "A failed JSON-RPC 2.0 response; id is null when the request's id was unreadable."
    },
    "JsonRpcNotification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "readOnly": true,
              "type": "array",
              "items": {}
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "description": "A JSON-RPC 2.0 notification: a request without an id, never answered."
    },
    "JsonRpcRequest": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "readOnly": true,
              "type": "array",
              "items": {}
            }
          ]
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "description": "A JSON-RPC 2.0 request: answered by a response with the same id."
    },
    "JsonRpcSuccess": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "result": {}
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "description": "A successful JSON-RPC 2.0 response."
    },
    "MostraInitializeParams": {
      "type": "object",
      "properties": {
        "client": {
          "$ref": "#/definitions/ClientInfo"
        },
        "revisions": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/definitions/ClientCapabilities"
        },
        "ports": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PortName"
          }
        },
        "home": {
          "allOf": [
            {
              "$ref": "#/definitions/HomeConfig"
            }
          ]
        }
      },
      "required": [
        "client",
        "revisions",
        "capabilities",
        "ports"
      ]
    },
    "MostraInitializeResult": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/definitions/Revision"
        },
        "instance": {
          "$ref": "#/definitions/InstanceInfo"
        },
        "capabilities": {
          "$ref": "#/definitions/InstanceCapabilities"
        },
        "warnings": {
          "readOnly": true,
          "type": "array",
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        }
      },
      "required": [
        "revision",
        "instance",
        "capabilities",
        "warnings"
      ]
    },
    "MostraShutdownParams": {
      "type": "object",
      "properties": {}
    },
    "MostraShutdownResult": {
      "type": "object",
      "properties": {}
    },
    "MutationId": {
      "type": "string",
      "pattern": "^mut_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Mutation ID: \"mut_\" followed by a 26-character ULID."
    },
    "PortName": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "description": "A host port name: identity, submissions, drafts, reviews, addressing, trustedControls, capture, secrets, pty, or ai (reserved). Open for later ports."
    },
    "Revision": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "Protocol revision: a calendar date in YYYY-MM-DD form."
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Action run ID: \"run_\" followed by a 26-character ULID."
    },
    "SubmissionId": {
      "type": "string",
      "pattern": "^sub_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Submission ID: \"sub_\" followed by a 26-character ULID."
    },
    "ThreadId": {
      "type": "string",
      "pattern": "^thr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Thread ID: \"thr_\" followed by a 26-character ULID."
    },
    "TokenId": {
      "type": "string",
      "pattern": "^tok_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Capability token ID: \"tok_\" followed by a 26-character ULID."
    },
    "VersionId": {
      "type": "string",
      "pattern": "^ver_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Version ID: \"ver_\" followed by 26 characters of Crockford base32."
    },
    "ViewId": {
      "type": "string",
      "pattern": "^vw_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "View ID: \"vw_\" followed by a 26-character ULID."
    },
    "ViewerId": {
      "type": "string",
      "pattern": "^vwr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Viewer ID: \"vwr_\" followed by a 26-character ULID."
    }
  }
}
