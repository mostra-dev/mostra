{
  "name": "@mostra/contract-connector",
  "version": "0.0.0",
  "description": "The contract a Mostra data connector implements: feed an artifact's live sources from a data source.",
  "license": "Apache-2.0",
  "author": "The Mostra Authors",
  "homepage": "https://github.com/mostra-dev/mostra/tree/main/packages/contract-connector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mostra-dev/mostra.git",
    "directory": "packages/contract-connector"
  },
  "bugs": "https://github.com/mostra-dev/mostra/issues",
  "keywords": [
    "mostra",
    "plugin",
    "contract",
    "connector"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@mostra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "api": "mostra-tools api"
  },
  "devDependencies": {
    "@mostra/tools": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
